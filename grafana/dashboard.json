{
  "overwrite": true,
  "dashboard": {
    "uid": "bakstg-nodejs-demo2-dashboard",
    "title": "Service: bakstg-nodejs-demo2 (Node.js) — Prometheus & Fluentd/Loki",
    "tags": ["bakstg-nodejs-demo2", "nodejs", "prometheus", "loki", "fluentd"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Requests Total — bakstg-nodejs-demo2 (Prometheus /metrics)",
        "type": "timeseries",
        "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus-eks" },
        "targets": [
          {
            "expr": "sum by (endpoint) (app_http_requests_total{app=\"bakstg-nodejs-demo2\"})",
            "legendFormat": "{{endpoint}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Node.js Uptime & CPU Usage — bakstg-nodejs-demo2 (Prometheus)",
        "type": "timeseries",
        "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus-eks" },
        "targets": [
          {
            "expr": "app_uptime_seconds{app=\"bakstg-nodejs-demo2\"}",
            "legendFormat": "uptime (s)"
          },
          {
            "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{pod=~\"bakstg-nodejs-demo2.*\",container!=\"\"}[5m]))",
            "legendFormat": "CPU: {{pod}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Node.js Pod Memory Working Set — bakstg-nodejs-demo2 (Prometheus)",
        "type": "timeseries",
        "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus-eks" },
        "targets": [
          {
            "expr": "sum by (pod) (container_memory_working_set_bytes{pod=~\"bakstg-nodejs-demo2.*\",container!=\"\"})",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Live Node.js Logs — bakstg-nodejs-demo2 (Fluentd -> Loki)",
        "type": "logs",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
        "datasource": { "type": "loki", "uid": "loki-eks" },
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        },
        "targets": [
          {
            "expr": "{app=\"bakstg-nodejs-demo2\"}"
          }
        ]
      }
    ]
  }
}
